#version 460 core

layout (local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout (std430, binding = 0) restrict writeonly buffer bitMapBuffer {
    uint[] bitMap;
};

uniform ivec3 size;
uniform bool invert;
uniform int rotation;
uniform int blockSize;
uniform mat4 rotationMatrix;

uniform int stepHeight;
uniform int heightOffset;
uniform int thickness;
uniform float slope;

uint zOrderCurveValue(uint value) {
    uint zOrderValue = 0;
    for (uint index = 0; index < 10; index++) {
        uint bit = value >> index & 1;
        bit <<= index * 3;
        zOrderValue |= bit;
    }
    return zOrderValue;
}

bool isValidCoord(vec3 coord) {
    return coord.x >= 0 && coord.y >= 0 && coord.z >= 0 && coord.x < size.x && coord.y < size.y && coord.z < size.z;
}

bool isInside(float x, float y, float z);

bool check(int x, int y, int z) {
    x = x / blockSize * blockSize;
    y = y / blockSize * blockSize;
    z = z / blockSize * blockSize;
    vec3 rotated = (rotationMatrix * vec4(x + 0.5, y + 0.5, z + 0.5, 1)).xyz;
    return isValidCoord(rotated) && isInside(rotated.x, rotated.y, rotated.z) != invert;
}

uint computeBits(int x, int y, int z) {
    uint bits = 0;

    if (check(x + 0, y + 0, z + 0)) bits |= 1 << 0;
    if (check(x + 0, y + 0, z + 1)) bits |= 1 << 1;
    if (check(x + 0, y + 1, z + 0)) bits |= 1 << 2;
    if (check(x + 0, y + 1, z + 1)) bits |= 1 << 3;
    if (check(x + 1, y + 0, z + 0)) bits |= 1 << 4;
    if (check(x + 1, y + 0, z + 1)) bits |= 1 << 5;
    if (check(x + 1, y + 1, z + 0)) bits |= 1 << 6;
    if (check(x + 1, y + 1, z + 1)) bits |= 1 << 7;

    if (check(x + 0, y + 0, z + 2)) bits |= 1 << 8;
    if (check(x + 0, y + 0, z + 3)) bits |= 1 << 9;
    if (check(x + 0, y + 1, z + 2)) bits |= 1 << 10;
    if (check(x + 0, y + 1, z + 3)) bits |= 1 << 11;
    if (check(x + 1, y + 0, z + 2)) bits |= 1 << 12;
    if (check(x + 1, y + 0, z + 3)) bits |= 1 << 13;
    if (check(x + 1, y + 1, z + 2)) bits |= 1 << 14;
    if (check(x + 1, y + 1, z + 3)) bits |= 1 << 15;

    if (check(x + 0, y + 2, z + 0)) bits |= 1 << 16;
    if (check(x + 0, y + 2, z + 1)) bits |= 1 << 17;
    if (check(x + 0, y + 3, z + 0)) bits |= 1 << 18;
    if (check(x + 0, y + 3, z + 1)) bits |= 1 << 19;
    if (check(x + 1, y + 2, z + 0)) bits |= 1 << 20;
    if (check(x + 1, y + 2, z + 1)) bits |= 1 << 21;
    if (check(x + 1, y + 3, z + 0)) bits |= 1 << 22;
    if (check(x + 1, y + 3, z + 1)) bits |= 1 << 23;

    if (check(x + 0, y + 2, z + 2)) bits |= 1 << 24;
    if (check(x + 0, y + 2, z + 3)) bits |= 1 << 25;
    if (check(x + 0, y + 3, z + 2)) bits |= 1 << 26;
    if (check(x + 0, y + 3, z + 3)) bits |= 1 << 27;
    if (check(x + 1, y + 2, z + 2)) bits |= 1 << 28;
    if (check(x + 1, y + 2, z + 3)) bits |= 1 << 29;
    if (check(x + 1, y + 3, z + 2)) bits |= 1 << 30;
    if (check(x + 1, y + 3, z + 3)) bits |= 1 << 31;

    return bits;
}

void main() {
    int x = int(gl_GlobalInvocationID.x) << 2;
    int y = int(gl_GlobalInvocationID.y) << 2;
    int z = int(gl_GlobalInvocationID.z) << 2;

    uint index = zOrderCurveValue(gl_GlobalInvocationID.x) << 2 | zOrderCurveValue(gl_GlobalInvocationID.y) << 1 | zOrderCurveValue(gl_GlobalInvocationID.z);
    bitMap[index * 2 + 0] = computeBits(x + 0, y, z);
    bitMap[index * 2 + 1] = computeBits(x + 2, y, z);
}

bool isInsideRotated(float a, float b, float c) {
    int outerThreshold = (size.x + heightOffset) / stepHeight;
    int innerThreshold = min(outerThreshold - 1, outerThreshold - thickness / stepHeight);
    
    float distance = int(min(b, c)) / stepHeight * slope + int(a) / stepHeight;
    return distance < outerThreshold && distance >= innerThreshold;
}

bool isInside(float x, float y, float z) {
    switch (rotation) {
        case 0: return isInsideRotated(size.x - z, x, y);
        case 1: return isInsideRotated(size.x - z, x, size.x - y);
        case 2: return isInsideRotated(size.x - z, size.x - x, size.x - y);
        case 3: return isInsideRotated(size.x - z, size.x - x, y);

        case 4: return isInsideRotated(size.x - y, x, z);
        case 5: return isInsideRotated(size.x - y, x, size.x - z);
        case 6: return isInsideRotated(size.x - y, size.x - x, size.x - z);
        case 7: return isInsideRotated(size.x - y, size.x - x, z);

        case 8: return isInsideRotated(size.x - x, y, z);
        case 9: return isInsideRotated(size.x - x, y, size.x - z);
        case 10: return isInsideRotated(size.x - x, size.x - y, size.x - z);
        case 11: return isInsideRotated(size.x - x, size.x - y, z);

        case 12: return isInsideRotated(z, x, y);
        case 13: return isInsideRotated(z, x, size.x - y);
        case 14: return isInsideRotated(z, size.x - x, size.x - y);
        case 15: return isInsideRotated(z, size.x - x, y);

        case 16: return isInsideRotated(y, x, z);
        case 17: return isInsideRotated(y, x, size.x - z);
        case 18: return isInsideRotated(y, size.x - x, size.x - z);
        case 19: return isInsideRotated(y, size.x - x, z);

        case 20: return isInsideRotated(x, y, z);
        case 21: return isInsideRotated(x, y, size.x - z);
        case 22: return isInsideRotated(x, size.x - y, size.x - z);
        case 23: return isInsideRotated(x, size.x - y, z);
    }
    return false;
}